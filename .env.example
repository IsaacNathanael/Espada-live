# Copy this file to .env and fill only the services you use.
# The real .env is ignored by Git.
AISSTREAM_API_KEY=
GFW_API_ACCESS_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
OPEN_METEO_API_KEY=

# OPEN_METEO_API_KEY is optional. Leave it blank for the free public endpoint;
# set a customer key only when a dedicated production endpoint is required.
# Copernicus Marine credentials remain in the official toolbox credential store.
# CDSE OAuth credentials are for Data Space satellite processing, not Copernicus Marine.
